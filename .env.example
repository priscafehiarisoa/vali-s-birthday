# Path to the SQLite file (created automatically if missing)
DATABASE_PATH=data/guests.db

# Initial password for the /guest page. Only used the first time the DB is created;
# afterwards it lives (hashed) in the `settings` table. Change it with: npm run set-password <new>
GUEST_PAGE_PASSWORD=vali1234

# Random string used to sign the /guest session cookie
SESSION_SECRET=replace-with-a-long-random-string
