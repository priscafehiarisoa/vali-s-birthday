# --- Database ---
# Production (Vercel): hosted Turso database (https://turso.tech). Leave empty locally
# to use the SQLite file below instead.
# e.g. libsql://vali-birthday-yourname.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local dev only: path to the SQLite file (created automatically)
DATABASE_PATH=data/guests.db

# --- /guest page ---
# Initial password, only used when the database is empty; afterwards it lives (hashed)
# in the `settings` table. Change it with: npm run set-password -- <new>
GUEST_PAGE_PASSWORD=vali1234

# Random string used to sign the /guest session cookie
SESSION_SECRET=replace-with-a-long-random-string
